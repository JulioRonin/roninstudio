# ~/.hermes/.env
# Modelo: uno de los dos (el proveedor se elige con `hermes model`)
ANTHROPIC_API_KEY=
# NVIDIA (build.nvidia.com, nivel gratis para pruebas; empieza con nvapi-)
NVIDIA_API_KEY=
# Musashi
MUSASHI_URL=https://musashi-three.vercel.app
MUSASHI_API_KEY=
# Webhooks (Musashi -> Hermes)
WEBHOOK_ENABLED=true
WEBHOOK_PORT=8644
WEBHOOK_SECRET=
HERMES_WEBHOOK_SECRET=
# API server
API_SERVER_ENABLED=true
API_SERVER_PORT=8642
API_SERVER_KEY=
HERMES_API_KEY=
