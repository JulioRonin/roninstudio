{
  "framework": null,
  "installCommand": "echo skip-install",
  "buildCommand": "echo skip-build",
  "outputDirectory": ".",
  "routes": [
    {
      "src": "/(musashi|research_notes)(/.*)?",
      "status": 404
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/c/(.*)",
      "dest": "https://musashi-three.vercel.app/c/$1"
    },
    {
      "src": "/_next/(.*)",
      "dest": "https://musashi-three.vercel.app/_next/$1"
    },
    {
      "src": "/api/publico/(.*)",
      "dest": "https://musashi-three.vercel.app/api/publico/$1"
    },
    {
      "src": "/api/diagnostico",
      "dest": "https://musashi-three.vercel.app/api/publico/diagnostico"
    },
    {
      "src": "/vertice/demo",
      "dest": "https://vertice-demo-kappa.vercel.app/vertice/demo"
    },
    {
      "src": "/vertice/demo/(.*)",
      "dest": "https://vertice-demo-kappa.vercel.app/vertice/demo/$1"
    }
  ]
}
