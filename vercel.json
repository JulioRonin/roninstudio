{
  "framework": null,
  "installCommand": "echo skip-install",
  "buildCommand": "echo skip-build",
  "outputDirectory": ".",
  "routes": [
    { "src": "/(musashi|research_notes)(/.*)?", "status": 404 },
    { "handle": "filesystem" },
    { "src": "/vertice/demo", "dest": "https://vertice-demo-kappa.vercel.app/vertice/demo" },
    { "src": "/vertice/demo/(.*)", "dest": "https://vertice-demo-kappa.vercel.app/vertice/demo/$1" }
  ]
}
